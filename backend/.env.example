# Copy manually to .env only when live credentials have been authorized.
# Default mock makes no provider calls. No real key belongs in this file.
DEBATE_MODE=mock
HOST=127.0.0.1
PORT=3001

# User-selected provider. This example remains mock and contains no credentials.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
# Set the exact approved model ID before live use; no model is selected implicitly.
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=3000
# Optional for new rounds 3/4. If unset, an explicit legacy cap above is inherited.
# LLM_DEBATE_OUTPUT_TOKENS=4500

MAX_CONCURRENT=2
CLIENT_REQUESTS_PER_MINUTE=5
GLOBAL_REQUESTS_PER_MINUTE=20
SESSION_TOKEN_BUDGET=200000
SESSION_CALL_LIMIT=100
# 0 keeps a lifetime cap; production can renew the same caps hourly (3600000).
# Pending reservations remain charged across window boundaries.
SESSION_BUDGET_WINDOW_MS=0
